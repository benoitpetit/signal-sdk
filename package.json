{
    "name": "signal-sdk",
    "version": "0.2.7",
    "description": "A comprehensive TypeScript SDK for Signal Messenger with native JSON-RPC support, providing high-performance messaging, bot framework, and full signal-cli integration.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "signal-sdk": "scripts/cli.js"
    },
    "files": [
        "dist/*.js",
        "dist/*.d.ts",
        "dist/managers/",
        "dist/bot/",
        "scripts/",
        "docs/",
        "README.md",
        "LICENSE",
        "logo.png"
    ],
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run release:check",
        "test": "jest",
        "test:coverage": "jest --coverage --runInBand",
        "test:ci": "jest --ci --coverage --runInBand",
        "test:watch": "jest --watch",
        "test:signal-cli": "jest --runInBand src/tests/SignalCli*.test.ts src/tests/signal-cli*.test.ts",
        "test:bot": "jest --runInBand src/tests/SignalBot*.test.ts src/tests/MediaManager.test.ts",
        "test:managers": "jest --runInBand src/tests/*Manager*.test.ts src/tests/manager-regressions.test.ts",
        "release:check": "bash scripts/release-check.sh",
        "postinstall": "node scripts/install.js",
        "connect": "node scripts/connect.js",
        "signal:connect": "node examples/sdk/00-device-linking.js",
        "example:basic": "node examples/sdk/01-basic-usage.js",
        "example:quick-start": "node examples/sdk/02-quick-start.js",
        "example:group-management": "node examples/sdk/03-group-management.js",
        "example:contact-management": "node examples/sdk/04-contact-management.js",
        "example:file-handling": "node examples/sdk/05-file-handling.js",
        "example:minimal-bot": "node examples/bot/01-minimal-bot.js",
        "example:advanced-bot": "node examples/bot/02-advanced-bot.js",
        "example:advanced-bot-2": "node examples/bot/03-advanced-bot.js",
        "lint": "eslint 'src/**/*.ts'",
        "check": "npm run lint && npm run build && npm run test:ci",
        "format": "prettier --write 'src/**/*.{ts,js}'"
    },
    "keywords": [
        "signal",
        "signal-cli",
        "messaging",
        "bot",
        "typescript",
        "json-rpc",
        "sdk",
        "automation"
    ],
    "author": "devbyben",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/benoitpetit/signal-sdk.git"
    },
    "homepage": "https://github.com/benoitpetit/signal-sdk#readme",
    "bugs": {
        "url": "https://github.com/benoitpetit/signal-sdk/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.10",
        "@types/qrcode-terminal": "^0.12.2",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "dotenv": "^16.4.5",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.0.4",
        "prettier": "^3.8.1",
        "ts-jest": "^29.4.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "qrcode-terminal": "^0.12.0",
        "tar": "^7.5.22",
        "uuid": "^11.1.1"
    }
}
